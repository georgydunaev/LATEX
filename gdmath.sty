% gdmath.sty
% Mathematical styling package for logic, set theory, category theory, and proof assistants.
% Generated and maintained for the LATEX workspace repository.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gdmath}[2026/11/14 v2.0 Mathematical logic, set theory, category theory, and proof macros]

% =============================================================================
% 1. Core Package Dependencies
% =============================================================================
\RequirePackage{amsmath}
\RequirePackage{amsfonts}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{mathtools}
\RequirePackage{float}
\RequirePackage{hyperref}

% Safe operator declaration helper to prevent macro collisions
\providecommand{\DeclareMathOperatorSafe}[2]{%
  \ifdefined#1\relax
    \renewcommand{#1}{\operatorname{#2}}%
  \else
    \DeclareMathOperator{#1}{#2}%
  \fi
}

% =============================================================================
% 2. Theorem and Proof Environments
% =============================================================================
\theoremstyle{definition}
\@ifundefined{definition}{\newtheorem{definition}{Definition}[section]}{}
\@ifundefined{lemma}{\newtheorem{lemma}{Lemma}[section]}{}
\@ifundefined{theorem}{\newtheorem{theorem}{Theorem}[section]}{}
\@ifundefined{exercise}{\newtheorem{exercise}{Exercise}[section]}{}
\@ifundefined{corollary}{\newtheorem{corollary}{Corollary}[section]}{}
\@ifundefined{proposition}{\newtheorem{proposition}{Proposition}[section]}{}
\@ifundefined{remark}{\newtheorem{remark}{Remark}[section]}{}
\@ifundefined{example}{\newtheorem{example}{Example}[section]}{}

% Proof shorthands
\providecommand{\myprf}{\noindent\textbf{Proof.}}
\providecommand{\myqed}{\hfill\textbf{Q.E.D.}}

% =============================================================================
% 3. Relational and Definitional Connectives
% =============================================================================
\providecommand{\LRA}{\Longleftrightarrow}
\providecommand{\defi}{\mathrm{def}}
\providecommand{\eqdef}{\stackrel{\defi}{=}}
\providecommand{\rsto}{\stackrel{\mathrm{RS}}{\to}}
\providecommand{\propdef}{\stackrel{\defi}{\ \Longleftrightarrow\ }}

% =============================================================================
% 4. Mathematical Logic and Proof Theory
% =============================================================================
\providecommand{\Tau}{\mathcal{T}}
\DeclareMathOperatorSafe{\Spec}{Spec}
\DeclareMathOperatorSafe{\Const}{Const}
\DeclareMathOperatorSafe{\Var}{Var}
\DeclareMathOperatorSafe{\Func}{Func}
\DeclareMathOperatorSafe{\Pred}{Pred}
\DeclareMathOperatorSafe{\Term}{Term}
\DeclareMathOperatorSafe{\Fm}{Fm}
\DeclareMathOperatorSafe{\FV}{FV}
\DeclareMathOperatorSafe{\WF}{WF}
\DeclareMathOperatorSafe{\iproof}{proof}
\DeclareMathOperatorSafe{\var}{var}
\DeclareMathOperatorSafe{\term}{term}
\DeclareMathOperatorSafe{\prop}{prop}
\DeclareMathOperatorSafe{\type}{type}
\DeclareMathOperatorSafe{\statement}{stmnt}

% =============================================================================
% 5. Set Theory and Class Theory
% =============================================================================
\DeclareMathOperatorSafe{\Set}{Set}
\providecommand{\Pow}{\mathcal{P}}
\providecommand{\inter}{\bigcap}
\providecommand{\interclass}{\bigcap_{C}}

\DeclareMathOperatorSafe{\Fun}{Fun}
\DeclareMathOperatorSafe{\Rel}{Rel}
\DeclareMathOperatorSafe{\dom}{dom}
\providecommand{\apo}{{'}}
\DeclareMathOperatorSafe{\The}{The}

\DeclareMathOperatorSafe{\TOrd}{TOrd}
\DeclareMathOperatorSafe{\Tr}{Tr}
\DeclareMathOperatorSafe{\mysucc}{succ}

% =============================================================================
% 6. Category Theory
% =============================================================================
\DeclareMathOperatorSafe{\Ob}{Ob}
\DeclareMathOperatorSafe{\Mor}{Mor}
\DeclareMathOperatorSafe{\Cat}{Cat}
\DeclareMathOperatorSafe{\Hom}{Hom}
\DeclareMathOperatorSafe{\Nat}{Nat}
\providecommand{\HomMor}{\widetilde{\Hom}}
\providecommand{\FMor}{\widetilde{F}}
\providecommand{\GMor}{\widetilde{G}}
\DeclareMathOperatorSafe{\op}{op}
\DeclareMathOperatorSafe{\id}{id}
\DeclareMathOperatorSafe{\mor}{mor}

% =============================================================================
% 7. Formal Proof Assistants and Type Theory
% =============================================================================
\DeclareMathOperatorSafe{\Truej}{Truej}
\DeclareMathOperatorSafe{\ITerm}{ITerm}
\DeclareMathOperatorSafe{\False}{False}
\DeclareMathOperatorSafe{\spec}{spec}
\DeclareMathOperatorSafe{\allI}{allI}
\DeclareMathOperatorSafe{\exI}{exI}
\DeclareMathOperatorSafe{\exE}{exE}
\DeclareMathOperatorSafe{\judgement}{jdmnt}
\providecommand{\Un}{\mathcal{U}}
\providecommand{\Dd}{\mathcal{D}}

% =============================================================================
% 8. Semantic Brackets and Delimiters
% =============================================================================
\providecommand{\llbrack}{[\![}
\providecommand{\rrbrack}{]\!]}
\providecommand{\llbracket}{[\![}
\providecommand{\rrbracket}{]\!]}
\providecommand{\sem}[1]{\llbracket #1 \rrbracket}
\providecommand{\tuple}[1]{\langle #1 \rangle}
\providecommand{\cornerquote}[1]{\ulcorner #1 \urcorner}

\endinput
